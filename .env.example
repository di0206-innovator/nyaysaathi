# ══════════════════════════════════════════════════════════════
# NyaySaathi — Environment Configuration Template
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local and populate with your credentials.
# NEVER commit real credentials, service role keys, or tokens to git.

# ── 1. Application Base URL ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 2. Supabase PostgreSQL & Auth ─────────────────────────────
# Required for live database persistence, Auth JWTs, and Row Level Security.
# In local development without Supabase, the app falls back to MemoryStorageAdapter.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# ── 3. Google Gemini AI (Document Intelligence & RAG) ─────────
# Server-side only. Required for live multi-agent legal reasoning and embeddings.
GEMINI_API_KEY=your-gemini-api-key-here

# ── 4. Background Job Worker & Cron Dispatch ──────────────────
# Secret key used to authorize internal worker queue execution (/api/jobs/worker).
INTERNAL_WORKER_KEY=generate-a-strong-random-secret-for-worker
CRON_SECRET=generate-a-strong-random-secret-for-cron

# ── 5. Google Document AI (Optional - Cloud OCR Engine) ───────
# Optional: If configured, replaces fallback Tesseract OCR for legal documents.
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=your-docai-processor-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── 6. Client Analytics & Demo Feature Flags ──────────────────
# Optional: Google Analytics measurement ID (format: G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Set to true only in sandbox preview environments to enable mock user toggle
# NEXT_PUBLIC_DEMO_MODE=false
